+	template<typename Vs>
+	static inline bool getShaderExecutionModeArgument(const Vs& spirv, spv::ExecutionModel model,
+									const std::string& entryName, spv::ExecutionMode mode,
+									uint32_t& value, std::string& errorLog) {
+#ifndef SPIRV_CROSS_EXCEPTIONS_TO_ASSERTIONS
+		try {
+#endif
+			SPIRV_CROSS_NAMESPACE::Parser parser(spirv);
+			parser.parse();
+			SPIRV_CROSS_NAMESPACE::CompilerReflection reflect(parser.get_parsed_ir());
+			if (!entryName.empty()) { reflect.set_entry_point(entryName, model); }
+			value = mode == spv::ExecutionModeInvocations && !reflect.get_execution_mode_bitset().get(mode)
+				? 1 : reflect.get_execution_mode_argument(mode);
+			return true;
+#ifndef SPIRV_CROSS_EXCEPTIONS_TO_ASSERTIONS
+		} catch (SPIRV_CROSS_NAMESPACE::CompilerError& ex) {
+			errorLog = ex.what();
+			return false;
+		}
+#endif
+	}
