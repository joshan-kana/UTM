diff --git a/Scripts/gen_moltenvk_rev_hdr.sh b/Scripts/gen_moltenvk_rev_hdr.sh
index c49ea4e6..1255874b 100755
--- a/Scripts/gen_moltenvk_rev_hdr.sh
+++ b/Scripts/gen_moltenvk_rev_hdr.sh
@@ -1,8 +1,19 @@
 #!/bin/bash
 
-# Record the MoltenVK GIT revision as a derived header file suitable for including in a build
-MVK_GIT_REV=$(git rev-parse HEAD)
+# Include patched source content in MoltenVK's pipeline cache identity.
+MVK_REPO=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)
+MVK_SOURCE_REV=$(
+    {
+        git -C "$MVK_REPO" rev-parse HEAD
+        git -C "$MVK_REPO" diff --raw -z --no-abbrev --no-renames HEAD
+        MVK_SPIRV_SOURCE="${SPIRV_CROSS_PATCHED:-$MVK_REPO/External/SPIRV-Cross}"
+        if git -C "$MVK_SPIRV_SOURCE" rev-parse --git-dir >/dev/null 2>&1; then
+            git -C "$MVK_SPIRV_SOURCE" rev-parse HEAD
+            git -C "$MVK_SPIRV_SOURCE" diff --raw -z --no-abbrev --no-renames HEAD
+        fi
+    } | shasum -a 256 | cut -d' ' -f1
+)
 MVK_HDR_FILE="${BUILT_PRODUCTS_DIR}/mvkGitRevDerived.h"
 echo "// Auto-generated by MoltenVK" > "${MVK_HDR_FILE}"
-echo "static const char* mvkRevString = \"${MVK_GIT_REV}\";" >> "${MVK_HDR_FILE}"
+echo "static const char* mvkRevString = \"${MVK_SOURCE_REV}\";" >> "${MVK_HDR_FILE}"
 
