+// The mesh shader's draw-info layout must match both SPIRV-Cross and MVKCmdDraw.mm.
+struct GeometryDrawInfo {
+    int32_t indexed;
+    int32_t indexSize;
+    uint64_t indexBuffer;
+    uint32_t vertexStrides[31];
+    uint32_t firstVertex;
+    uint32_t firstIndex;
+    int32_t baseVertex;
+    uint32_t firstInstance;
+    uint32_t drawIndex;
+    uint32_t geometryInvocations;
+    uint8_t topoStrip;
+    uint8_t topoFan;
+};
+
+struct GeometryDispatchArgs {
+    uint32_t threadgroupsX;
+    uint32_t threadgroupsY;
+    uint32_t threadgroupsZ;
+};
+
+static inline uint32_t geometryPrimitiveCount(uint32_t vertices, uint32_t topology) {
+    switch (topology) {
+        case 0: return vertices;                              // Point list
+        case 1: return vertices / 2;                          // Line list
+        case 2: return vertices >= 2 ? vertices - 1 : 0;     // Line strip
+        case 3: return vertices / 3;                          // Triangle list
+        case 4:                                                // Triangle strip
+        case 5: return vertices >= 3 ? vertices - 2 : 0;     // Triangle fan
+        default: return 0;
+    }
+}
+
+kernel void cmdDrawGeometryIndirectConvertBuffers(
+    const device char* srcBuff [[buffer(0)]],
+    device GeometryDispatchArgs* dispatchBuff [[buffer(1)]],
+    device char* infoBuff [[buffer(2)]],
+    constant GeometryDrawInfo& templateInfo [[buffer(3)]],
+    constant uint32_t& srcStride [[buffer(4)]],
+    constant uint32_t& drawCount [[buffer(5)]],
+    constant uint32_t& topology [[buffer(6)]],
+    uint idx [[thread_position_in_grid]]) {
+    if (idx >= drawCount) return;
+    const device auto& src = *reinterpret_cast<const device MTLDrawPrimitivesIndirectArguments*>(srcBuff + idx * srcStride);
+    dispatchBuff[idx] = {geometryPrimitiveCount(src.vertexCount, topology), src.instanceCount, 1};
+    device auto& dst = *reinterpret_cast<device GeometryDrawInfo*>(infoBuff + idx * 256);
+    dst = templateInfo;
+    dst.firstVertex = src.vertexStart;
+    dst.firstInstance = src.baseInstance;
+    dst.drawIndex = idx;
+}
+
+kernel void cmdDrawIndexedGeometryIndirectConvertBuffers(
+    const device char* srcBuff [[buffer(0)]],
+    device GeometryDispatchArgs* dispatchBuff [[buffer(1)]],
+    device char* infoBuff [[buffer(2)]],
+    constant GeometryDrawInfo& templateInfo [[buffer(3)]],
+    constant uint32_t& srcStride [[buffer(4)]],
+    constant uint32_t& drawCount [[buffer(5)]],
+    constant uint32_t& topology [[buffer(6)]],
+    uint idx [[thread_position_in_grid]]) {
+    if (idx >= drawCount) return;
+    const device auto& src = *reinterpret_cast<const device MTLDrawIndexedPrimitivesIndirectArguments*>(srcBuff + idx * srcStride);
+    dispatchBuff[idx] = {geometryPrimitiveCount(src.indexCount, topology), src.instanceCount, 1};
+    device auto& dst = *reinterpret_cast<device GeometryDrawInfo*>(infoBuff + idx * 256);
+    dst = templateInfo;
+    dst.firstIndex = src.indexStart;
+    dst.baseVertex = src.baseVertex;
+    dst.firstInstance = src.baseInstance;
+    dst.drawIndex = idx;
 }
 
