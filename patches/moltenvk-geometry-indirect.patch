+// Vulkan draw parameters can be written by the GPU. Keep their translation on-GPU
+// and bind independently encoded DrawInfo for each indirect draw.
+static void encodeGeometryIndirect(MVKCommandEncoder* cmdEncoder,
+                                   id<MTLBuffer> srcBuffer,
+                                   VkDeviceSize srcOffset,
+                                   uint32_t drawCount,
+                                   uint32_t srcStride,
+                                   const MVKIndexMTLBufferBinding* indexBinding) {
+    if (!drawCount) { return; }
+
+    auto* pipeline = cmdEncoder->getGraphicsPipeline();
+    uint32_t topology = pipeline->getVkPrimitiveTopology();
+    if (topology > VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN) {
+        cmdEncoder->_cmdBuffer->reportError(VK_ERROR_FEATURE_NOT_PRESENT,
+                                           "Unsupported geometry indirect primitive topology: %u", topology);
+        return;
+    }
+
+    DrawInfo info = {};
+    info.geometryInvocations = pipeline->getGeometryInvocationCount();
+    info.topoStrip = topology == VK_PRIMITIVE_TOPOLOGY_LINE_STRIP ||
+                     topology == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP;
+    info.topoFan = topology == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN;
+    if (indexBinding) {
+        info.indexed = true;
+        info.indexSize = (int)mvkMTLIndexTypeSizeInBytes((MTLIndexType)indexBinding->mtlIndexType);
+        info.indexBuffer = indexBinding->mtlBuffer.gpuAddress + indexBinding->offset;
+    }
+    setGeometryVertexStrides(info, cmdEncoder, pipeline);
+
+    constexpr size_t infoStride = 256;
+    constexpr size_t dispatchStride = sizeof(MTLDispatchThreadgroupsIndirectArguments);
+    auto* dispatchBuffer = cmdEncoder->getTempMTLBuffer(dispatchStride * drawCount, true);
+    auto* infoBuffer = cmdEncoder->getTempMTLBuffer(infoStride * drawCount, true);
+
+    cmdEncoder->encodeStoreActions(true);
+    id<MTLComputeCommandEncoder> compute = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseDrawIndirectConvertBuffers);
+    auto& computeState = cmdEncoder->getMtlCompute();
+    id<MTLComputePipelineState> convert = cmdEncoder->getCommandEncodingPool()->
+        getCmdDrawGeometryIndirectConvertBuffersMTLComputePipelineState(indexBinding != nullptr);
+    if (!convert) { return; }
+    computeState.bindPipeline(compute, convert);
+    computeState.bindBuffer(compute, srcBuffer, srcOffset, 0);
+    computeState.bindBuffer(compute, dispatchBuffer->_mtlBuffer, dispatchBuffer->_offset, 1);
+    computeState.bindBuffer(compute, infoBuffer->_mtlBuffer, infoBuffer->_offset, 2);
+    computeState.bindStructBytes(compute, &info, 3);
+    computeState.bindStructBytes(compute, &srcStride, 4);
+    computeState.bindStructBytes(compute, &drawCount, 5);
+    computeState.bindStructBytes(compute, &topology, 6);
+    NSUInteger threads = convert.threadExecutionWidth;
+    if (cmdEncoder->getMetalFeatures().nonUniformThreadgroups) {
+        [compute dispatchThreads: MTLSizeMake(drawCount, 1, 1)
+             threadsPerThreadgroup: MTLSizeMake(threads, 1, 1)];
+    } else {
+        [compute dispatchThreadgroups: MTLSizeMake(mvkCeilingDivide<NSUInteger>(drawCount, threads), 1, 1)
+                threadsPerThreadgroup: MTLSizeMake(threads, 1, 1)];
+    }
+
+    cmdEncoder->beginMetalRenderPass(kMVKCommandUseRestartSubpass);
+    cmdEncoder->_isIndexedDraw = indexBinding != nullptr;
+    cmdEncoder->finalizeDrawState(kMVKGraphicsStageRasterization);
+    if (!pipeline->hasValidMTLPipelineStates()) { return; }
+
+    if (indexBinding) {
+        [cmdEncoder->_mtlRenderEncoder useResource: indexBinding->mtlBuffer
+                                           usage: MTLResourceUsageRead
+                                          stages: MTLRenderStageObject];
+    }
+    for (uint32_t i = 0; i < drawCount; ++i) {
+        [cmdEncoder->_mtlRenderEncoder setObjectBuffer: infoBuffer->_mtlBuffer
+                                               offset: infoBuffer->_offset + i * infoStride
+                                              atIndex: pipeline->getDrawInfoBufferIndex()];
+        [cmdEncoder->_mtlRenderEncoder drawMeshThreadgroupsWithIndirectBuffer: dispatchBuffer->_mtlBuffer
+                                                         indirectBufferOffset: dispatchBuffer->_offset + i * dispatchStride
+                                                  threadsPerObjectThreadgroup: MTLSizeMake(1, 1, 1)
+                                                    threadsPerMeshThreadgroup: MTLSizeMake(1, 1, 1)];
+    }
+}
