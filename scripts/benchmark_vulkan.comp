#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
    uint values[];
} source;
layout(set = 0, binding = 1, std430) writeonly buffer Output {
    uint values[];
} destination;
layout(push_constant) uniform Parameters {
    uint count;
    uint rounds;
} parameters;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= parameters.count)
        return;

    uint value = source.values[index];
    for (uint iteration = 0; iteration < parameters.rounds; ++iteration) {
        value = (value ^ (value >> 13)) * 1664525u + 1013904223u;
    }
    destination.values[index] = value;
}
